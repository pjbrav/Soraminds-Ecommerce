# Copy to .env (or export in your shell). NEVER commit a real key.
# Everything below is optional — the prototype runs with zero API keys.

# Enables gpt-4o-mini description generation + OpenAI vision conflict detection.
# Every call is logged to the llm_usage table (provider, model, tokens).
OPENAI_API_KEY=

# Any OpenAI-compatible endpoint/model works.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o-mini

# Embedding provider: auto (default) | local | fallback
# SPICEHUB_EMBEDDING_PROVIDER=auto
# SPICEHUB_EMBEDDING_MODEL=all-MiniLM-L6-v2
